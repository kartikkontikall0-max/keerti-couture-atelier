# ─────────────────────────────────────────────────────────────────────────────
# Keerti Couture Frontend Environment Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env.local for local development.
# For production deployments, set this variable in your hosting provider
# (e.g., Vercel, AWS Amplify, Netlify) to point to your live backend domain.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Base URL (must include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

