# ─────────────────────────────────────────────────────────────────────────────
# Keerti Couture Backend Environment Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and replace all placeholder values with your
# actual service credentials before running the server.
# NEVER commit your production .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection URI
# In development, you may use a local MongoDB instance.
# In production, provide a secure connection string to MongoDB Atlas or managed cluster.
MONGO_URI=mongodb://localhost:27017/tailor_shop

# JWT Secret Key (Use a cryptographically random string of at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_chars

# CORS Origin Whitelist (Comma-separated list of allowed web origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cloudinary Image Storage Credentials (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Business WhatsApp Phone Number (Digits only, including country code, e.g. 919876543210)
BUSINESS_WHATSAPP=919876543210

# Transactional Email SMTP Configuration (e.g., SendGrid, Amazon SES, Mailgun, Brevo, Postmark)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
FROM_EMAIL="Keerti Couture Atelier" <concierge@keerticouture.com>

# Reverse Proxy Trust (Set to 'true' or '1' behind Nginx, Cloudflare, AWS ALB, or Heroku/Render)
TRUST_PROXY=true

# Optional Administrator Bootstrap Credentials (for running seed.js or bootstrap_admin.js)
ADMIN_EMAIL=admin@keerticouture.com
ADMIN_PASSWORD=change_this_admin_password_on_deploy
ADMIN_NAME=Store Administrator

